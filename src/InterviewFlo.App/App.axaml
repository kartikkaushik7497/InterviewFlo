<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="InterviewFlo.App.App"
             xmlns:local="using:InterviewFlo.App"
             xmlns:vmCandidate="using:InterviewFlo.App.ViewModels.Candidate"
             xmlns:viewCandidate="using:InterviewFlo.App.Views.Candidate"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <DataTemplate DataType="vmCandidate:CandidateFeedbackViewModel">
            <viewCandidate:CandidateFeedbackView />
        </DataTemplate>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <SolidColorBrush x:Key="ThemeBg" Color="#050607" />
        <SolidColorBrush x:Key="ThemeCardBg" Color="#CC13171F" />
        <SolidColorBrush x:Key="ThemeCardBorder" Color="#2F3A4A" />
        <SolidColorBrush x:Key="ThemeInsetBg" Color="#B0171B24" />
        <SolidColorBrush x:Key="ThemeText" Color="#F3F4F6" />
        <SolidColorBrush x:Key="ThemeMuted" Color="#98A2B3" />
        <SolidColorBrush x:Key="ThemeAccent" Color="#FB923C" />
        <SolidColorBrush x:Key="ThemeAccentStrong" Color="#F97316" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <Style Selector="TextBlock.PageTitle">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
        </Style>

        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
        </Style>

        <Style Selector="TextBlock.Muted">
            <Setter Property="Foreground" Value="{DynamicResource ThemeMuted}" />
        </Style>

        <Style Selector="Border.ThemeCard">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style Selector="Border.ThemeInset">
            <Setter Property="Background" Value="{DynamicResource ThemeInsetBg}" />
            <Setter Property="BorderBrush" Value="#2E3645" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <Style Selector="TextBox, ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
            <Setter Property="Background" Value="#2A2F38" />
            <Setter Property="BorderBrush" Value="#3D4657" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style Selector="TextBox:pointerover, ComboBox:pointerover">
            <Setter Property="BorderBrush" Value="#54627A" />
        </Style>

        <Style Selector="TextBox:focus, TextBox:focus-within, ComboBox:focus, ComboBox:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
            <Setter Property="Background" Value="#2A313D" />
            <Setter Property="BorderBrush" Value="#465167" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#343D4C" />
            <Setter Property="BorderBrush" Value="#5B6882" />
        </Style>

        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="#252B36" />
        </Style>

        <Style Selector="Button.Primary">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentStrong}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.Primary:pointerover">
            <Setter Property="Background" Value="#FB7D2A" />
            <Setter Property="BorderBrush" Value="#FDBA74" />
        </Style>

        <Style Selector="Button.Danger">
            <Setter Property="Background" Value="#7F1D1D" />
            <Setter Property="BorderBrush" Value="#B91C1C" />
            <Setter Property="Foreground" Value="#FEE2E2" />
        </Style>

        <Style Selector="DataGrid">
            <Setter Property="Background" Value="#11151C" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
            <Setter Property="BorderBrush" Value="#2E3645" />
            <Setter Property="RowBackground" Value="#131922" />
            <Setter Property="GridLinesVisibility" Value="All" />
        </Style>
    </Application.Styles>
</Application>
