<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="InterviewFlo.App.Views.Candidate.CandidateInterviewView"
             x:CompileBindings="False">
    <Grid ClipToBounds="True" Background="#F3F6FA">
        <Grid IsHitTestVisible="False" Opacity="0.35">
            <Canvas>
                <Border Width="2600" Height="1" Background="#2F94A3B8" Canvas.Top="64" />
                <Border Width="2600" Height="1" Background="#2F94A3B8" Canvas.Top="128" />
                <Border Width="2600" Height="1" Background="#2F94A3B8" Canvas.Top="192" />
                <Border Width="2600" Height="1" Background="#2F94A3B8" Canvas.Top="256" />
                <Border Width="2600" Height="1" Background="#2F94A3B8" Canvas.Top="320" />
                <Border Width="2600" Height="1" Background="#2F94A3B8" Canvas.Top="384" />
                <Border Width="2600" Height="1" Background="#2F94A3B8" Canvas.Top="448" />
                <Border Width="2600" Height="1" Background="#2F94A3B8" Canvas.Top="512" />
                <Border Width="2600" Height="1" Background="#2F94A3B8" Canvas.Top="576" />
                <Border Width="2600" Height="1" Background="#2F94A3B8" Canvas.Top="640" />

                <Border Width="1" Height="1800" Background="#2A8A9AAE" Canvas.Left="90" />
                <Border Width="1" Height="1800" Background="#2A8A9AAE" Canvas.Left="180" />
                <Border Width="1" Height="1800" Background="#2A8A9AAE" Canvas.Left="270" />
                <Border Width="1" Height="1800" Background="#2A8A9AAE" Canvas.Left="360" />
                <Border Width="1" Height="1800" Background="#2A8A9AAE" Canvas.Left="450" />
                <Border Width="1" Height="1800" Background="#2A8A9AAE" Canvas.Left="540" />
                <Border Width="1" Height="1800" Background="#2A8A9AAE" Canvas.Left="630" />
                <Border Width="1" Height="1800" Background="#2A8A9AAE" Canvas.Left="720" />
                <Border Width="1" Height="1800" Background="#2A8A9AAE" Canvas.Left="810" />
                <Border Width="1" Height="1800" Background="#2A8A9AAE" Canvas.Left="900" />
                <Border Width="1" Height="1800" Background="#2A8A9AAE" Canvas.Left="990" />
                <Border Width="1" Height="1800" Background="#2A8A9AAE" Canvas.Left="1080" />
                <Border Width="1" Height="1800" Background="#2A8A9AAE" Canvas.Left="1170" />
                <Border Width="1" Height="1800" Background="#2A8A9AAE" Canvas.Left="1260" />
                <Border Width="1" Height="1800" Background="#2A8A9AAE" Canvas.Left="1350" />
            </Canvas>
        </Grid>

        <Canvas IsHitTestVisible="False">
            <Border Canvas.Left="210" Canvas.Top="140" Width="96" Height="96" CornerRadius="48" Background="#8EEA580C" BoxShadow="0 0 34 10 #66EA580C" />
            <Border Canvas.Left="300" Canvas.Top="450" Width="50" Height="50" CornerRadius="25" Background="#8EE11D48" BoxShadow="0 0 26 8 #66E11D48" />
            <Border Canvas.Right="150" Canvas.Top="170" Width="150" Height="250" CornerRadius="80" Background="#5922C55E" BoxShadow="0 0 90 20 #4422C55E" />
            <Border Canvas.Right="220" Canvas.Top="430" Width="46" Height="46" CornerRadius="23" Background="#8EBE123C" BoxShadow="0 0 26 8 #66BE123C" />
        </Canvas>

        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12" Margin="10">
        <Border Background="#F8F9FB" BorderBrush="#CDD5DF" BorderThickness="1" CornerRadius="10" Padding="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="3">
                    <TextBlock Text="Live Interview Desk" Foreground="#132A32" FontWeight="Bold" FontSize="30" />
                    <TextBlock Text="{Binding JobRole}" Foreground="#50636B" FontSize="14" />
                    <TextBlock Text="{Binding InterviewCategory}" Foreground="#4F7A86" FontSize="13" />
                    <TextBlock Text="{Binding CameraStatus}" Foreground="#6D7C84" FontSize="12" />
                </StackPanel>

                <Border Grid.Column="1" Background="#F1F5F8" BorderBrush="#C9D4DB" BorderThickness="1" CornerRadius="8" Padding="10,6">
                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock Text="Question" Foreground="#55656E" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding QuestionNumber}" Foreground="#15323B" FontWeight="Bold" FontSize="22" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding TotalQuestions}" Foreground="#6E7F88" FontSize="12" HorizontalAlignment="Right" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="1.9*,1*" ColumnSpacing="12">
            <Border Background="#F8F9FB" BorderBrush="#CDD5DF" BorderThickness="1" CornerRadius="10" Padding="10">
                <Grid RowDefinitions="*,Auto,Auto,Auto,Auto" RowSpacing="8">
                    <Border Grid.Row="0" Background="#ECEFF3" BorderBrush="#D5DEE7" BorderThickness="1" CornerRadius="10" Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ChatMessages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3,0,3">
                                            <Border MaxWidth="540"
                                                    Padding="10"
                                                    CornerRadius="10"
                                                    HorizontalAlignment="{Binding BubbleAlignment}"
                                                    Background="{Binding BubbleBackground}"
                                                    BorderBrush="{Binding BubbleBorder}"
                                                    BorderThickness="1">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{Binding Sender}" Foreground="{Binding SenderColor}" FontWeight="SemiBold" FontSize="12" />
                                                    <TextBlock Text="{Binding Text}" Foreground="#1E2933" TextWrapping="Wrap" FontSize="14" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <TextBox Grid.Row="1"
                             Text="{Binding TranscriptInput, Mode=TwoWay}"
                             AcceptsReturn="True"
                             Height="120"
                             TextWrapping="Wrap"
                             Background="#FFFFFF"
                             BorderBrush="#C9D3DD"
                             BorderThickness="1"
                             CornerRadius="8"
                             PlaceholderText="Type answer here or use mic transcription..." />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                        <Button Content="Start Recording" Command="{Binding StartRecordingCommand}" Background="#DCEBFF" Foreground="#214E7A" BorderBrush="#AEC8E5" />
                        <Button Content="Stop + Transcribe" Command="{Binding StopRecordingAndTranscribeCommand}" Background="#E4F8F3" Foreground="#146C5A" BorderBrush="#A9D8CF" />
                        <Button Content="Submit Answer" Classes="Primary" Command="{Binding SubmitAnswerCommand}" />
                    </StackPanel>

                    <Border Grid.Row="3" Background="#F1F5F8" BorderBrush="#D3DCE5" BorderThickness="1" CornerRadius="8" Padding="8">
                        <TextBlock Text="{Binding RecordingStatus}" Foreground="#4D6069" FontSize="12" />
                    </Border>

                    <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#C9D3DD" BorderThickness="1" CornerRadius="8" Padding="8">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Live Captions" Foreground="#3F5662" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="{Binding LiveCaption}" Foreground="#1F3A47" TextWrapping="Wrap" />
                            <Border Background="#F4F7FA" BorderBrush="#D6DFE8" BorderThickness="1" CornerRadius="6" Padding="6" Height="110">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding LiveTranscriptLog}" Foreground="#3E5662" TextWrapping="Wrap" FontSize="12" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="*,*" RowSpacing="12">
                <Border Grid.Row="0" Background="#F8F9FB" BorderBrush="#CDD5DF" BorderThickness="1" CornerRadius="10" Padding="10">
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                        <TextBlock Text="User Camera Feed" Foreground="#21353E" FontWeight="SemiBold" FontSize="14" />
                        <Border Grid.Row="1" Background="#0E1720" BorderBrush="#C9D3DD" BorderThickness="1" CornerRadius="8">
                            <Image Source="{Binding CameraFrame}" Stretch="UniformToFill" />
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="#F8F9FB" BorderBrush="#CDD5DF" BorderThickness="1" CornerRadius="10" Padding="10">
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                        <TextBlock Text="Interviewer Avatar" Foreground="#21353E" FontWeight="SemiBold" FontSize="14" />
                        <Border Grid.Row="1" Background="#2A2E35" CornerRadius="8" BorderBrush="#3E4653" BorderThickness="1">
                            <Grid>
                                <Border Width="110" Height="110" CornerRadius="55" Background="#5FC8A7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse Width="66" Height="66" Fill="#F8E8D7" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-12,0,0" />
                                <Ellipse Width="18" Height="18" Fill="#1F2937" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-14,-14,0,0" />
                                <Ellipse Width="18" Height="18" Fill="#1F2937" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,-14,0,0" />
                                <Border Width="64" Height="28" CornerRadius="14" Background="#4F5D74" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,46,0,0" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Border>
                <StackPanel>
                    <TextBlock Text="{Binding Feedback}" Foreground="#314651" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#425C68" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Button Grid.Column="1" Content="Finish Interview" Command="{Binding FinishNowCommand}" />
            <Button Grid.Column="2" Content="Logout" Classes="Danger" Command="{Binding LogoutCommand}" />
        </Grid>
        </Grid>
    </Grid>
</UserControl>
