<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="InterviewFlo.App.Views.Candidate.CandidateRulesView"
             x:CompileBindings="False">
    <Grid RowDefinitions="*,Auto" RowSpacing="12" Margin="8">
        <Border Classes="ThemeCard">
            <StackPanel Spacing="12">
                <TextBlock Text="Rules and Guidance" Classes="PageTitle" FontSize="28" />
                <TextBlock Text="Please read this before entering the waiting lobby." Classes="Muted" />
                <ScrollViewer Height="320">
                    <TextBlock Text="{Binding RulesText}" TextWrapping="Wrap" Foreground="#E2E8F0" />
                </ScrollViewer>
                <CheckBox IsChecked="{Binding HasAcknowledgedRules, Mode=TwoWay}"
                          Content="I have read, understood, and agree to the rules and permissions." />
                <Border Classes="ThemeInset">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#E2E8F0" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Logout" Classes="Danger" Command="{Binding LogoutCommand}" />
            <Button Content="Proceed to Lobby" Classes="Primary" Command="{Binding ContinueCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
