<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MockUpAi.App.Views.Auth.PasswordResetView"
             x:CompileBindings="False">
    <Border Width="560"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Classes="ThemeCard"
            Padding="26">
        <StackPanel Spacing="14">
            <TextBlock Text="Reset Password" Classes="PageTitle" FontSize="28" />
            <TextBlock Text="This account must set a new password before proceeding." Classes="Muted" FontSize="14" />

            <TextBlock Text="New Password" Classes="Muted" />
            <TextBox Text="{Binding NewPassword, Mode=TwoWay}" PlaceholderText="Enter secure password" />

            <TextBlock Text="Confirm Password" Classes="Muted" />
            <TextBox Text="{Binding ConfirmPassword, Mode=TwoWay}" PlaceholderText="Re-enter password" />

            <Button Content="Reset Password" Classes="Primary" Command="{Binding ResetPasswordCommand}" Height="42" />

            <Button Content="Logout" Classes="Danger" Command="{Binding LogoutCommand}" />

            <Border Classes="ThemeInset">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#E2E8F0" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
