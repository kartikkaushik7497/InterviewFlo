<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MockUpAi.App.Views.Auth.PasswordResetView"
             x:CompileBindings="False">
    <Border Width="540"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#0F172A"
            CornerRadius="18"
            Padding="26">
        <StackPanel Spacing="14">
            <TextBlock Text="Reset Password" FontSize="28" FontWeight="Bold" Foreground="White" />
            <TextBlock Text="This account must set a new password before proceeding." FontSize="14" Foreground="#9FB4FF" />

            <TextBlock Text="New Password" Foreground="#D6E1FF" />
            <TextBox Text="{Binding NewPassword, Mode=TwoWay}" PlaceholderText="Enter secure password" />

            <TextBlock Text="Confirm Password" Foreground="#D6E1FF" />
            <TextBox Text="{Binding ConfirmPassword, Mode=TwoWay}" PlaceholderText="Re-enter password" />

            <Button Content="Reset Password"
                    Command="{Binding ResetPasswordCommand}"
                    Height="42"
                    Background="#3B82F6"
                    Foreground="White"
                    FontWeight="SemiBold" />

            <Button Content="Logout" Command="{Binding LogoutCommand}" />

            <Border Background="#1E293B" CornerRadius="10" Padding="10">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#E2E8F0" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
