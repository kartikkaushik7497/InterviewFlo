<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MockUpAi.App.Views.MainWindow"
        Width="1280"
        Height="820"
        MinWidth="1100"
        MinHeight="720"
        Title="MockUpAi"
        Icon="/Assets/avalonia-logo.ico"
        x:CompileBindings="False">
    <Border Background="#0B1220" Padding="20">
        <Grid RowDefinitions="Auto,*" RowSpacing="16">
            <Border Background="#17233B" CornerRadius="16" Padding="16">
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding AppTitle}" FontSize="30" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="{Binding AppSubtitle}" FontSize="14" Foreground="#A3B3D4" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Foreground="#9FB4FF"
                               FontSize="12"
                               Text="AI-Driven Company Interview Simulation" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="#111B2F" CornerRadius="16" Padding="16">
                <ContentControl Content="{Binding CurrentPage}" />
            </Border>
        </Grid>
    </Border>
</Window>
