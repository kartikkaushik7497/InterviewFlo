<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MockUpAi.App.Views.MainWindow"
        Width="1280"
        Height="820"
        MinWidth="1100"
        MinHeight="720"
        Title="InterviewFlo"
        Icon="/Assets/avalonia-logo.ico"
        WindowDecorations="Full"
        ExtendClientAreaToDecorationsHint="False"
        CanResize="True"
        CanMinimize="True"
        CanMaximize="True"
        ShowInTaskbar="True"
        WindowState="Maximized"
        x:CompileBindings="False">
    <Grid ClipToBounds="True">
        <Border Background="{DynamicResource ThemeBg}" />

        <Grid IsHitTestVisible="False" Opacity="0.12">
            <Canvas>
                <Border Width="2600" Height="1" Background="#2AFFFFFF" Canvas.Top="72" />
                <Border Width="2600" Height="1" Background="#2AFFFFFF" Canvas.Top="144" />
                <Border Width="2600" Height="1" Background="#2AFFFFFF" Canvas.Top="216" />
                <Border Width="2600" Height="1" Background="#2AFFFFFF" Canvas.Top="288" />
                <Border Width="2600" Height="1" Background="#2AFFFFFF" Canvas.Top="360" />
                <Border Width="2600" Height="1" Background="#2AFFFFFF" Canvas.Top="432" />
                <Border Width="2600" Height="1" Background="#2AFFFFFF" Canvas.Top="504" />
                <Border Width="2600" Height="1" Background="#2AFFFFFF" Canvas.Top="576" />
                <Border Width="2600" Height="1" Background="#2AFFFFFF" Canvas.Top="648" />

                <Border Width="1" Height="1800" Background="#22FFFFFF" Canvas.Left="108" />
                <Border Width="1" Height="1800" Background="#22FFFFFF" Canvas.Left="216" />
                <Border Width="1" Height="1800" Background="#22FFFFFF" Canvas.Left="324" />
                <Border Width="1" Height="1800" Background="#22FFFFFF" Canvas.Left="432" />
                <Border Width="1" Height="1800" Background="#22FFFFFF" Canvas.Left="540" />
                <Border Width="1" Height="1800" Background="#22FFFFFF" Canvas.Left="648" />
                <Border Width="1" Height="1800" Background="#22FFFFFF" Canvas.Left="756" />
                <Border Width="1" Height="1800" Background="#22FFFFFF" Canvas.Left="864" />
                <Border Width="1" Height="1800" Background="#22FFFFFF" Canvas.Left="972" />
                <Border Width="1" Height="1800" Background="#22FFFFFF" Canvas.Left="1080" />
                <Border Width="1" Height="1800" Background="#22FFFFFF" Canvas.Left="1188" />
                <Border Width="1" Height="1800" Background="#22FFFFFF" Canvas.Left="1296" />
            </Canvas>
        </Grid>

        <Canvas IsHitTestVisible="False" Opacity="0.35">
            <Border Canvas.Left="-100" Canvas.Top="-40" Width="260" Height="260" CornerRadius="130" Background="#2C2563EB" BoxShadow="0 0 100 26 #2C2563EB" />
            <Border Canvas.Right="-80" Canvas.Top="60" Width="220" Height="220" CornerRadius="110" Background="#26F97316" BoxShadow="0 0 90 24 #26F97316" />
            <Border Canvas.Left="520" Canvas.Bottom="-120" Width="260" Height="260" CornerRadius="130" Background="#1A22C55E" BoxShadow="0 0 100 26 #1A22C55E" />
        </Canvas>

        <ContentControl Content="{Binding CurrentPage}" Margin="22" />
    </Grid>
</Window>
