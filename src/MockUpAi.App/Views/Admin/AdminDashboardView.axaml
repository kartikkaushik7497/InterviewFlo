<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dg="using:Avalonia.Controls"
             x:Class="MockUpAi.App.Views.Admin.AdminDashboardView"
             x:CompileBindings="False">
    <Grid RowDefinitions="Auto,*" RowSpacing="14" Margin="8">
        <TextBlock Text="Admin Control Center" Classes="PageTitle" />

        <Grid Grid.Row="1" ColumnDefinitions="430,*" ColumnSpacing="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Border Classes="ThemeCard">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Create Candidate" Classes="SectionTitle" />
                            <TextBlock Text="Candidate ID" Classes="Muted" />
                            <TextBox Text="{Binding CandidateIdInput, Mode=TwoWay}" PlaceholderText="cand_1001" />

                            <TextBlock Text="Temporary Password" Classes="Muted" />
                            <TextBox Text="{Binding CandidatePasswordInput, Mode=TwoWay}" PlaceholderText="Strong temp password" />

                            <TextBlock Text="Role" Classes="Muted" />
                            <ComboBox ItemsSource="{Binding AvailableRoles}" SelectedItem="{Binding SelectedJobRole, Mode=TwoWay}" />

                            <TextBlock Text="Job Description" Classes="Muted" />
                            <TextBox Text="{Binding CandidateJobDescription, Mode=TwoWay}" AcceptsReturn="True" Height="80" TextWrapping="Wrap" PlaceholderText="Role expectations" />

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Category" Classes="Muted" />
                                    <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Difficulty" Classes="Muted" />
                                    <ComboBox ItemsSource="{Binding DifficultyOptions}" SelectedItem="{Binding SelectedDifficulty, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="AI Provider" Classes="Muted" />
                                    <ComboBox ItemsSource="{Binding AiProviderOptions}" SelectedItem="{Binding SelectedAiProvider, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Passing Marks (1-100)" Classes="Muted" />
                            <TextBox Text="{Binding CandidatePassingScoreInput, Mode=TwoWay}" PlaceholderText="60" />

                            <TextBlock Text="Expiry Date (optional)" Classes="Muted" />
                            <TextBox Text="{Binding CandidateExpiryDateInput, Mode=TwoWay}" PlaceholderText="yyyy-MM-dd" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Generate Random Key + Password" Command="{Binding GenerateRandomCredentialsCommand}" />
                                <Button Content="Create Candidate" Classes="Primary" Command="{Binding CreateCandidateCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="ThemeCard">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Edit Selected Candidate" Classes="SectionTitle" />
                            <TextBlock Text="Role" Classes="Muted" />
                            <TextBox Text="{Binding EditJobRole, Mode=TwoWay}" />

                            <TextBlock Text="Job Description" Classes="Muted" />
                            <TextBox Text="{Binding EditJobDescription, Mode=TwoWay}" AcceptsReturn="True" Height="80" TextWrapping="Wrap" />

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Category" Classes="Muted" />
                                    <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding EditCategory, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Difficulty" Classes="Muted" />
                                    <ComboBox ItemsSource="{Binding DifficultyOptions}" SelectedItem="{Binding EditDifficulty, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="AI Provider" Classes="Muted" />
                                    <ComboBox ItemsSource="{Binding AiProviderOptions}" SelectedItem="{Binding EditAiProvider, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Passing Marks (1-100)" Classes="Muted" />
                            <TextBox Text="{Binding EditPassingScoreInput, Mode=TwoWay}" />

                            <TextBlock Text="Expiry Date (optional)" Classes="Muted" />
                            <TextBox Text="{Binding EditExpiryDateInput, Mode=TwoWay}" PlaceholderText="yyyy-MM-dd" />

                            <CheckBox IsChecked="{Binding EditIsActive, Mode=TwoWay}" Content="Account Active" />

                            <TextBlock Text="Reset Password" Classes="Muted" />
                            <TextBox Text="{Binding ResetPasswordInput, Mode=TwoWay}" PlaceholderText="New password" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Update" Command="{Binding UpdateCandidateCommand}" />
                                <Button Content="Reset Password" Command="{Binding ResetCandidatePasswordCommand}" />
                                <Button Content="Delete" Classes="Danger" Command="{Binding DeleteCandidateCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Classes="ThemeCard">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                    <TextBlock Text="Candidate Interview Dashboard" Classes="SectionTitle" />

                    <Grid Grid.Row="1" ColumnDefinitions="2*,2*,1.2*,1.5*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Search candidate or role" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding RoleFilters}" SelectedItem="{Binding SelectedRoleFilter, Mode=TwoWay}" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding ActiveFilters}" SelectedItem="{Binding SelectedActiveFilter, Mode=TwoWay}" />
                        <ComboBox Grid.Column="3" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortBy, Mode=TwoWay}" />
                        <CheckBox Grid.Column="4" IsChecked="{Binding SortDescending, Mode=TwoWay}" Content="Desc" VerticalAlignment="Center" />
                        <Button Grid.Column="5" Content="Apply" Command="{Binding ApplyFiltersCommand}" />
                        <Button Grid.Column="6" Content="CSV" Command="{Binding ExportCsvCommand}" />
                        <Button Grid.Column="7" Content="PDF" Command="{Binding ExportPdfCommand}" />
                    </Grid>

                    <dg:DataGrid Grid.Row="2"
                                 ItemsSource="{Binding CandidateRows}"
                                 SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
                                 AutoGenerateColumns="False"
                                 IsReadOnly="True"
                                 GridLinesVisibility="All">
                        <dg:DataGrid.Columns>
                            <dg:DataGridTextColumn Header="Candidate ID" Binding="{Binding CandidateId}" Width="*" />
                            <dg:DataGridTextColumn Header="Role" Binding="{Binding JobRole}" Width="*" />
                            <dg:DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" />
                            <dg:DataGridTextColumn Header="Difficulty" Binding="{Binding Difficulty}" Width="*" />
                            <dg:DataGridTextColumn Header="Pass Mark" Binding="{Binding PassingScore}" Width="*" />
                            <dg:DataGridTextColumn Header="AI" Binding="{Binding AiProvider}" Width="*" />
                            <dg:DataGridTextColumn Header="Status" Binding="{Binding InterviewStatus}" Width="*" />
                            <dg:DataGridTextColumn Header="Account" Binding="{Binding AccountStateDisplay}" Width="*" />
                            <dg:DataGridTextColumn Header="Interview Score" Binding="{Binding LatestInterviewScore}" Width="*" />
                            <dg:DataGridCheckBoxColumn Header="Passed" Binding="{Binding IsPassed}" Width="Auto" />
                            <dg:DataGridTextColumn Header="Role Fit" Binding="{Binding RoleFitScore}" Width="*" />
                            <dg:DataGridTextColumn Header="Questions" Binding="{Binding QuestionsAnswered}" Width="*" />
                            <dg:DataGridTextColumn Header="Expires" Binding="{Binding ExpiresAtDisplay}" Width="*" />
                            <dg:DataGridTextColumn Header="Completed At" Binding="{Binding CompletedAtDisplay}" Width="*" />
                        </dg:DataGrid.Columns>
                    </dg:DataGrid>

                    <Border Grid.Row="3" Classes="ThemeInset">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#E2E8F0" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" />
                            <Button Grid.Column="2" Content="Logout" Classes="Danger" Command="{Binding LogoutCommand}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
