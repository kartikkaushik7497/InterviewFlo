<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dg="using:Avalonia.Controls"
             x:Class="MockUpAi.App.Views.Admin.AdminDashboardView"
             x:CompileBindings="False">
    <Grid RowDefinitions="Auto,*" RowSpacing="14">
        <TextBlock Text="Admin Control Center"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="White" />

        <Grid Grid.Row="1" ColumnDefinitions="420,*" ColumnSpacing="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Border Background="#0F172A" CornerRadius="14" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Create Candidate" FontSize="18" Foreground="White" FontWeight="SemiBold" />
                            <TextBlock Text="Candidate ID" Foreground="#CBD5E1" />
                            <TextBox Text="{Binding CandidateIdInput, Mode=TwoWay}" PlaceholderText="cand_1001" />

                            <TextBlock Text="Temporary Password" Foreground="#CBD5E1" />
                            <TextBox Text="{Binding CandidatePasswordInput, Mode=TwoWay}" PlaceholderText="Strong temp password" />

                            <TextBlock Text="Role" Foreground="#CBD5E1" />
                            <ComboBox ItemsSource="{Binding AvailableRoles}" SelectedItem="{Binding SelectedJobRole, Mode=TwoWay}" />

                            <TextBlock Text="Job Description" Foreground="#CBD5E1" />
                            <TextBox Text="{Binding CandidateJobDescription, Mode=TwoWay}" AcceptsReturn="True" Height="80" TextWrapping="Wrap" PlaceholderText="Role expectations" />

                            <TextBlock Text="Expiry Date (optional)" Foreground="#CBD5E1" />
                            <TextBox Text="{Binding CandidateExpiryDateInput, Mode=TwoWay}" PlaceholderText="yyyy-MM-dd" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Generate Random Key + Password" Command="{Binding GenerateRandomCredentialsCommand}" />
                                <Button Content="Create Candidate" Command="{Binding CreateCandidateCommand}" Background="#2563EB" Foreground="White" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#0F172A" CornerRadius="14" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Edit Selected Candidate" FontSize="18" Foreground="White" FontWeight="SemiBold" />
                            <TextBlock Text="Role" Foreground="#CBD5E1" />
                            <TextBox Text="{Binding EditJobRole, Mode=TwoWay}" />

                            <TextBlock Text="Job Description" Foreground="#CBD5E1" />
                            <TextBox Text="{Binding EditJobDescription, Mode=TwoWay}" AcceptsReturn="True" Height="80" TextWrapping="Wrap" />

                            <TextBlock Text="Expiry Date (optional)" Foreground="#CBD5E1" />
                            <TextBox Text="{Binding EditExpiryDateInput, Mode=TwoWay}" PlaceholderText="yyyy-MM-dd" />

                            <CheckBox IsChecked="{Binding EditIsActive, Mode=TwoWay}" Content="Account Active" Foreground="#E2E8F0" />

                            <TextBlock Text="Reset Password" Foreground="#CBD5E1" />
                            <TextBox Text="{Binding ResetPasswordInput, Mode=TwoWay}" PlaceholderText="New password" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Update" Command="{Binding UpdateCandidateCommand}" />
                                <Button Content="Reset Password" Command="{Binding ResetCandidatePasswordCommand}" />
                                <Button Content="Delete" Command="{Binding DeleteCandidateCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Background="#0F172A" CornerRadius="14" Padding="14">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                    <TextBlock Text="Candidate Interview Dashboard" FontSize="18" Foreground="White" FontWeight="SemiBold" />

                    <Grid Grid.Row="1" ColumnDefinitions="2*,2*,1.2*,1.5*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Search candidate or role" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding RoleFilters}" SelectedItem="{Binding SelectedRoleFilter, Mode=TwoWay}" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding ActiveFilters}" SelectedItem="{Binding SelectedActiveFilter, Mode=TwoWay}" />
                        <ComboBox Grid.Column="3" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortBy, Mode=TwoWay}" />
                        <CheckBox Grid.Column="4" IsChecked="{Binding SortDescending, Mode=TwoWay}" Content="Desc" Foreground="#CBD5E1" VerticalAlignment="Center" />
                        <Button Grid.Column="5" Content="Apply" Command="{Binding ApplyFiltersCommand}" />
                        <Button Grid.Column="6" Content="CSV" Command="{Binding ExportCsvCommand}" />
                        <Button Grid.Column="7" Content="PDF" Command="{Binding ExportPdfCommand}" />
                    </Grid>

                    <dg:DataGrid Grid.Row="2"
                                 ItemsSource="{Binding CandidateRows}"
                                 SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
                                 AutoGenerateColumns="False"
                                 IsReadOnly="True"
                                 GridLinesVisibility="All">
                        <dg:DataGrid.Columns>
                            <dg:DataGridTextColumn Header="Candidate ID" Binding="{Binding CandidateId}" Width="*" />
                            <dg:DataGridTextColumn Header="Role" Binding="{Binding JobRole}" Width="*" />
                            <dg:DataGridTextColumn Header="Status" Binding="{Binding InterviewStatus}" Width="*" />
                            <dg:DataGridTextColumn Header="Account" Binding="{Binding AccountStateDisplay}" Width="*" />
                            <dg:DataGridTextColumn Header="Interview Score" Binding="{Binding LatestInterviewScore}" Width="*" />
                            <dg:DataGridTextColumn Header="Role Fit" Binding="{Binding RoleFitScore}" Width="*" />
                            <dg:DataGridTextColumn Header="Questions" Binding="{Binding QuestionsAnswered}" Width="*" />
                            <dg:DataGridTextColumn Header="Expires" Binding="{Binding ExpiresAtDisplay}" Width="*" />
                            <dg:DataGridTextColumn Header="Completed At" Binding="{Binding CompletedAtDisplay}" Width="*" />
                        </dg:DataGrid.Columns>
                    </dg:DataGrid>

                    <Border Grid.Row="3" Background="#1E293B" Padding="10" CornerRadius="10">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#E2E8F0" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" />
                            <Button Grid.Column="2" Content="Logout" Command="{Binding LogoutCommand}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
