<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MockUpAi.App.Views.Candidate.CandidateResultView"
             x:CompileBindings="False">
    <Grid Background="{DynamicResource LightShellBg}" Margin="12">
        <Border Background="#FFFFFF"
                BorderBrush="#CFE0EA"
                BorderThickness="1"
                CornerRadius="12"
                MaxWidth="780"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="24">
            <StackPanel Spacing="16">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <Border Width="72"
                            Height="72"
                            Background="#1E40AF"
                            BorderBrush="#60A5FA"
                            BorderThickness="1"
                            CornerRadius="36">
                        <TextBlock Text="OK"
                                   Foreground="#DBEAFE"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="{Binding SubmissionTitle}"
                               Foreground="#102331"
                               FontSize="30"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding SubmissionMessage}"
                               Foreground="#475569"
                               FontSize="15"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="620"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <Border Background="#F8FAFC"
                        BorderBrush="#D6E1EA"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="22" RowSpacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Candidate ID" Classes="LightMuted" />
                            <TextBlock Text="{Binding CandidateId}" Foreground="#0F172A" FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Job Role" Classes="LightMuted" />
                            <TextBlock Text="{Binding JobRole}" Foreground="#0F172A" FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Spacing="4">
                            <TextBlock Text="Questions Answered" Classes="LightMuted" />
                            <TextBlock Text="{Binding QuestionsSummary}" Foreground="#0F172A" FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <TextBlock Text="Submitted At" Classes="LightMuted" />
                            <TextBlock Text="{Binding CompletedAt}" Foreground="#0F172A" FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Spacing="4">
                            <TextBlock Text="Interview Type" Classes="LightMuted" />
                            <TextBlock Text="{Binding InterviewType}" Foreground="#0F172A" FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                            <TextBlock Text="Status" Classes="LightMuted" />
                            <TextBlock Text="{Binding SubmissionStatus}" Foreground="#047857" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14">
                    <TextBlock Text="{Binding AdminReviewMessage}"
                               Foreground="#1E3A8A"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </Border>

                <Border Background="#F8FAFC"
                        BorderBrush="#D6E1EA"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                        <TextBlock Text="Interview Timeline"
                                   Foreground="#334155"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <ScrollViewer Grid.Row="1"
                                      MaxHeight="190"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding TimelineItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto,*"
                                              ColumnSpacing="10"
                                              Margin="0,0,0,8">
                                            <Border Width="26"
                                                    Height="26"
                                                    CornerRadius="13"
                                                    Background="{Binding AccentBrush}"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Number}"
                                                           Foreground="#FFFFFF"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Border Grid.Column="1"
                                                    Background="#FFFFFF"
                                                    BorderBrush="#E2E8F0"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="9">
                                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="4">
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="#0F172A"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               MaxLines="2"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Border Grid.Column="1"
                                                            Background="{Binding BadgeBackground}"
                                                            BorderBrush="{Binding AccentBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="999"
                                                            Padding="8,2"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Status}"
                                                                   Foreground="{Binding BadgeForeground}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding Topic}"
                                                               Foreground="#64748B"
                                                               FontSize="12" />
                                                    <TextBlock Grid.Row="1"
                                                               Grid.Column="1"
                                                               Text="{Binding Subtitle}"
                                                               Foreground="#64748B"
                                                               FontSize="12" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="10">
                    <Button Content="Logout"
                            Classes="LightDanger"
                            Command="{Binding DoneCommand}"
                            MinWidth="180"
                            Height="42" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
