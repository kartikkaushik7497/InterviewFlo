<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MockUpAi.App.Views.Candidate.CandidateRulesView"
             x:CompileBindings="False">
    <Grid RowDefinitions="*,Auto" RowSpacing="12">
        <Border Background="#0F172A" CornerRadius="14" Padding="20">
            <StackPanel Spacing="12">
                <TextBlock Text="Rules &amp; Guidance" FontSize="26" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="Please read this before entering the waiting lobby." Foreground="#A8B7D9" />
                <ScrollViewer Height="320">
                    <TextBlock Text="{Binding RulesText}" TextWrapping="Wrap" Foreground="#E2E8F0" />
                </ScrollViewer>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Logout" Command="{Binding LogoutCommand}" />
            <Button Content="Proceed to Lobby"
                    Command="{Binding ContinueCommand}"
                    Background="#2563EB"
                    Foreground="White"
                    FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</UserControl>
