<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MockUpAi.App.Views.Candidate.CandidateInterviewView"
             x:CompileBindings="False">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <Border Background="#0F172A" CornerRadius="12" Padding="14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Spacing="4">
                    <TextBlock Text="Live AI Interview" FontSize="24" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="{Binding JobRole}" Foreground="#9FB4FF" />
                    <TextBlock Text="{Binding CameraStatus}" Foreground="#A8B7D9" FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="Question" Foreground="#A8B7D9" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding QuestionNumber}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding TotalQuestions}" Foreground="#A8B7D9" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="2*,1.2*,1.1*" ColumnSpacing="12">
            <Border Background="#0F172A" CornerRadius="12" Padding="14">
                <StackPanel Spacing="10">
                    <TextBlock Text="Current Question" FontSize="18" Foreground="White" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding QuestionPrompt}" TextWrapping="Wrap" Foreground="#E2E8F0" FontSize="15" />

                    <TextBlock Text="Speech-to-Text Transcript" Foreground="#A8B7D9" />
                    <TextBox Text="{Binding TranscriptInput, Mode=TwoWay}"
                             AcceptsReturn="True"
                             Height="170"
                             TextWrapping="Wrap"
                             PlaceholderText="Record answer or type manually" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Start Recording" Command="{Binding StartRecordingCommand}" />
                        <Button Content="Stop + Transcribe" Command="{Binding StopRecordingAndTranscribeCommand}" />
                        <Button Content="Submit Answer"
                                Command="{Binding SubmitAnswerCommand}"
                                Background="#2563EB"
                                Foreground="White"
                                FontWeight="SemiBold" />
                    </StackPanel>

                    <TextBlock Text="{Binding RecordingStatus}" Foreground="#A8B7D9" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#0F172A" CornerRadius="12" Padding="14">
                <StackPanel Spacing="10">
                    <TextBlock Text="Video Preview" FontSize="18" Foreground="White" FontWeight="SemiBold" />
                    <Border Background="#020617" CornerRadius="8" Height="240">
                        <Image Source="{Binding CameraFrame}" Stretch="UniformToFill" />
                    </Border>
                    <Button Content="Restart Camera" Command="{Binding RestartCameraCommand}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#0F172A" CornerRadius="12" Padding="14">
                <StackPanel Spacing="10">
                    <TextBlock Text="Evaluation Panel" FontSize="18" Foreground="White" FontWeight="SemiBold" />
                    <TextBlock Text="Running Interview Score" Foreground="#A8B7D9" />
                    <TextBlock Text="{Binding RunningScore}" FontSize="36" FontWeight="Bold" Foreground="#4ADE80" />

                    <TextBlock Text="AI Feedback" Foreground="#A8B7D9" />
                    <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" Foreground="#E2E8F0" />

                    <TextBlock Text="Status" Foreground="#A8B7D9" />
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#E2E8F0" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Finish Interview" Command="{Binding FinishNowCommand}" />
            <Button Content="Logout" Command="{Binding LogoutCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
