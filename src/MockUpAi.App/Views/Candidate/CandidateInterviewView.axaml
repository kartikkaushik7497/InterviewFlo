<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MockUpAi.App.Views.Candidate.CandidateInterviewView"
             x:CompileBindings="False">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12" Margin="8">
        <Border Classes="ThemeCard" Padding="14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Spacing="4">
                    <TextBlock Text="Live AI Interview" Classes="PageTitle" FontSize="24" />
                    <TextBlock Text="{Binding JobRole}" Classes="Muted" />
                    <TextBlock Text="{Binding CameraStatus}" Classes="Muted" FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="Question" Classes="Muted" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding QuestionNumber}" Foreground="#F3F4F6" FontWeight="Bold" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding TotalQuestions}" Classes="Muted" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="2*,1.2*,1.1*" ColumnSpacing="12">
            <Border Classes="ThemeCard" Padding="14">
                <StackPanel Spacing="10">
                    <TextBlock Text="Current Question" Classes="SectionTitle" />
                    <TextBlock Text="{Binding QuestionPrompt}" TextWrapping="Wrap" Foreground="#E2E8F0" FontSize="15" />

                    <TextBlock Text="Speech-to-Text Transcript" Classes="Muted" />
                    <TextBox Text="{Binding TranscriptInput, Mode=TwoWay}"
                             AcceptsReturn="True"
                             Height="170"
                             TextWrapping="Wrap"
                             PlaceholderText="Record answer or type manually" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Start Recording" Command="{Binding StartRecordingCommand}" />
                        <Button Content="Stop + Transcribe" Command="{Binding StopRecordingAndTranscribeCommand}" />
                        <Button Content="Submit Answer" Classes="Primary" Command="{Binding SubmitAnswerCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding RecordingStatus}" Classes="Muted" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="ThemeCard" Padding="14">
                <StackPanel Spacing="10">
                    <TextBlock Text="Video Preview" Classes="SectionTitle" />
                    <Border Background="#070B12" BorderBrush="#2E3645" BorderThickness="1" CornerRadius="10" Height="240">
                        <Image Source="{Binding CameraFrame}" Stretch="UniformToFill" />
                    </Border>
                    <Button Content="Restart Camera" Command="{Binding RestartCameraCommand}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Classes="ThemeCard" Padding="14">
                <StackPanel Spacing="10">
                    <TextBlock Text="Evaluation Panel" Classes="SectionTitle" />
                    <TextBlock Text="Running Interview Score" Classes="Muted" />
                    <TextBlock Text="{Binding RunningScore}" FontSize="36" FontWeight="Bold" Foreground="#4ADE80" />

                    <TextBlock Text="AI Feedback" Classes="Muted" />
                    <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" Foreground="#E2E8F0" />

                    <TextBlock Text="Status" Classes="Muted" />
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#E2E8F0" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Finish Interview" Command="{Binding FinishNowCommand}" />
            <Button Content="Logout" Classes="Danger" Command="{Binding LogoutCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
