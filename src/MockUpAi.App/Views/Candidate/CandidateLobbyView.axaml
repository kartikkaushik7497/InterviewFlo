<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MockUpAi.App.Views.Candidate.CandidateLobbyView"
             x:CompileBindings="False">
    <Grid Background="{DynamicResource LightShellBg}" Margin="14">
        <Border Classes="LightCard"
                MaxWidth="620"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="24">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16">
                <StackPanel Spacing="5"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Interview Waiting Lobby"
                               Classes="LightPageTitle"
                               FontSize="28"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                    <TextBlock Text="Your interview auto-starts quickly after the timer."
                               Classes="LightMuted"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                </StackPanel>

                <Border Grid.Row="1"
                        Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="22,18"
                        HorizontalAlignment="Center"
                        MinWidth="190">
                    <TextBlock Text="{Binding CountdownDisplay}"
                               FontSize="52"
                               FontWeight="Bold"
                               Foreground="#2563EB"
                               HorizontalAlignment="Center" />
                </Border>

                <Border Grid.Row="2"
                        Background="#F8FAFC"
                        BorderBrush="#D6E1EA"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12"
                        MinHeight="48">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#334155"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Border>

                <WrapPanel Grid.Row="3"
                           Orientation="Horizontal"
                           ItemSpacing="10"
                           LineSpacing="8"
                           HorizontalAlignment="Center">
                    <Button Content="Start Interview Now"
                            Classes="LightPrimary"
                            Command="{Binding StartNowCommand}"
                            MinWidth="170"
                            Height="42" />
                    <Button Content="Logout"
                            Classes="LightDanger"
                            Command="{Binding LogoutCommand}"
                            MinWidth="104"
                            Height="42" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
