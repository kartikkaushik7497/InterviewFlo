<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MockUpAi.App.Views.Candidate.CandidatePermissionView"
             x:CompileBindings="False">
    <Grid ClipToBounds="True" Background="{DynamicResource LightShellBg}">
        <Grid IsHitTestVisible="False" Opacity="0.08">
            <Canvas>
                <Border Width="2600" Height="1" Background="#CBD5E1" Canvas.Top="64" />
                <Border Width="2600" Height="1" Background="#CBD5E1" Canvas.Top="128" />
                <Border Width="2600" Height="1" Background="#CBD5E1" Canvas.Top="192" />
                <Border Width="2600" Height="1" Background="#CBD5E1" Canvas.Top="256" />
                <Border Width="2600" Height="1" Background="#CBD5E1" Canvas.Top="320" />
                <Border Width="2600" Height="1" Background="#CBD5E1" Canvas.Top="384" />
                <Border Width="2600" Height="1" Background="#CBD5E1" Canvas.Top="448" />
                <Border Width="2600" Height="1" Background="#CBD5E1" Canvas.Top="512" />
                <Border Width="2600" Height="1" Background="#CBD5E1" Canvas.Top="576" />
                <Border Width="2600" Height="1" Background="#CBD5E1" Canvas.Top="640" />

                <Border Width="1" Height="1800" Background="#CBD5E1" Canvas.Left="90" />
                <Border Width="1" Height="1800" Background="#CBD5E1" Canvas.Left="180" />
                <Border Width="1" Height="1800" Background="#CBD5E1" Canvas.Left="270" />
                <Border Width="1" Height="1800" Background="#CBD5E1" Canvas.Left="360" />
                <Border Width="1" Height="1800" Background="#CBD5E1" Canvas.Left="450" />
                <Border Width="1" Height="1800" Background="#CBD5E1" Canvas.Left="540" />
                <Border Width="1" Height="1800" Background="#CBD5E1" Canvas.Left="630" />
                <Border Width="1" Height="1800" Background="#CBD5E1" Canvas.Left="720" />
                <Border Width="1" Height="1800" Background="#CBD5E1" Canvas.Left="810" />
                <Border Width="1" Height="1800" Background="#CBD5E1" Canvas.Left="900" />
                <Border Width="1" Height="1800" Background="#CBD5E1" Canvas.Left="990" />
                <Border Width="1" Height="1800" Background="#CBD5E1" Canvas.Left="1080" />
                <Border Width="1" Height="1800" Background="#CBD5E1" Canvas.Left="1170" />
                <Border Width="1" Height="1800" Background="#CBD5E1" Canvas.Left="1260" />
                <Border Width="1" Height="1800" Background="#CBD5E1" Canvas.Left="1350" />
            </Canvas>
        </Grid>

        <Border Classes="LightCard"
                MaxWidth="836"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="18">
            <StackPanel Spacing="14">
                <TextBlock Text="Permission Check" Classes="LightPageTitle" FontSize="28" />
                <TextBlock Text="Camera and microphone are required before continuing." Classes="LightMuted" TextWrapping="Wrap" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Microphone"
                                   Foreground="#334155"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding MicrophoneDevices}"
                                  Classes="LightInput"
                                  SelectedItem="{Binding SelectedMicrophone, Mode=TwoWay}"
                                  MinHeight="42"
                                  HorizontalContentAlignment="Stretch"
                                  PlaceholderText="Select microphone" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Camera"
                                   Foreground="#334155"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding CameraDevices}"
                                  Classes="LightInput"
                                  SelectedItem="{Binding SelectedCamera, Mode=TwoWay}"
                                  MinHeight="42"
                                  HorizontalContentAlignment="Stretch"
                                  PlaceholderText="Select camera" />
                    </StackPanel>
                </Grid>

                <Border Background="#F8FAFC" BorderBrush="#D6E1EA" BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <Grid ColumnDefinitions="24,*" ColumnSpacing="12">
                        <Grid Width="22" Height="22" VerticalAlignment="Center">
                            <Border Width="22" Height="22" CornerRadius="11" Background="#0E2C23" BorderBrush="#22C55E" BorderThickness="1.2" />
                            <Path IsVisible="{Binding MicrophoneAccessGranted}"
                                  Width="12"
                                  Height="9"
                                  Stretch="Fill"
                                  Fill="#22C55E"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M0,4 L3.2,7.2 L10,0.8 L8.8,0 L3.2,5.2 L1.1,3.3 Z" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Microphone Access"
                                       Foreground="#0F172A"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Required for interview voice capture"
                                       Foreground="#64748B"
                                       FontSize="12" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#F8FAFC" BorderBrush="#D6E1EA" BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <Grid ColumnDefinitions="24,*" ColumnSpacing="12">
                        <Grid Width="22" Height="22" VerticalAlignment="Center">
                            <Border Width="22" Height="22" CornerRadius="11" Background="#0E2C23" BorderBrush="#22C55E" BorderThickness="1.2" />
                            <Path IsVisible="{Binding CameraAccessGranted}"
                                  Width="12"
                                  Height="9"
                                  Stretch="Fill"
                                  Fill="#22C55E"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M0,4 L3.2,7.2 L10,0.8 L8.8,0 L3.2,5.2 L1.1,3.3 Z" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Camera Access"
                                       Foreground="#0F172A"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Required for live video monitoring"
                                       Foreground="#64748B"
                                       FontSize="12" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#F8FAFC" BorderBrush="#D6E1EA" BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <Grid ColumnDefinitions="24,*" ColumnSpacing="12">
                        <Grid Width="22" Height="22" VerticalAlignment="Center">
                            <Border Width="22" Height="22" CornerRadius="11" Background="#10243A" BorderBrush="#60A5FA" BorderThickness="1.2" />
                            <TextBlock Text="STT"
                                       Foreground="#1D4ED8"
                                       FontSize="6"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Speech-to-Text Readiness"
                                       Foreground="#0F172A"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Local Whisper prepares during the interview and falls back safely when configured."
                                       Foreground="#64748B"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="8" VerticalAlignment="Center">
                    <Button Content="Request Access" Classes="LightNeutral" Command="{Binding RequestAccessCommand}" MinWidth="128" Height="42" />
                    <Button Content="Recheck" Classes="LightNeutral" Command="{Binding RecheckCommand}" MinWidth="92" Height="42" />
                    <Button Content="Continue" Classes="LightPrimary" Command="{Binding ContinueCommand}" MinWidth="96" Height="42" />
                    <Grid Width="18" Height="18" IsVisible="{Binding IsChecking}" VerticalAlignment="Center">
                        <Path Stroke="#4ADE80"
                              StrokeThickness="2"
                              StrokeLineCap="Round"
                              Data="M9,1 A8,8 0 1 1 8.99,1">
                            <Path.RenderTransform>
                                <RotateTransform Angle="{Binding LoadingAngle}" CenterX="9" CenterY="9" />
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                </WrapPanel>

                <Border Classes="LightInfo">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#1E3A8A" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
