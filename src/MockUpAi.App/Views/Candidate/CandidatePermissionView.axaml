<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MockUpAi.App.Views.Candidate.CandidatePermissionView"
             x:CompileBindings="False">
    <Border Classes="ThemeCard" MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8">
        <StackPanel Spacing="12">
            <TextBlock Text="Permission Check" Classes="PageTitle" FontSize="28" />
            <TextBlock Text="Camera and microphone are required. Speech-to-text key is recommended for automatic transcription." Classes="Muted" TextWrapping="Wrap" />

            <CheckBox IsChecked="{Binding MicrophoneAccessGranted, Mode=OneWay}" Content="Microphone Access" IsEnabled="False" />
            <CheckBox IsChecked="{Binding CameraAccessGranted, Mode=OneWay}" Content="Camera Access" IsEnabled="False" />
            <CheckBox IsChecked="{Binding SpeechTranscriptionAccessGranted, Mode=OneWay}" Content="Speech-to-Text Access (OpenAI key)" IsEnabled="False" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Recheck" Command="{Binding RecheckCommand}" />
                <Button Content="Continue" Classes="Primary" Command="{Binding ContinueCommand}" Height="42" />
            </StackPanel>

            <Border Classes="ThemeInset">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#E2E8F0" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
