<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MockUpAi.App.Views.Candidate.CandidatePermissionView"
             x:CompileBindings="False">
    <Border Background="#0F172A" CornerRadius="14" Padding="20" MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
            <TextBlock Text="Permission Check" FontSize="26" FontWeight="Bold" Foreground="White" />
            <TextBlock Text="Camera and microphone are required. Speech-to-text key is recommended for automatic transcription." Foreground="#A8B7D9" />

            <CheckBox IsChecked="{Binding MicrophoneAccessGranted, Mode=OneWay}" Foreground="#E2E8F0" Content="Microphone Access" IsEnabled="False" />
            <CheckBox IsChecked="{Binding CameraAccessGranted, Mode=OneWay}" Foreground="#E2E8F0" Content="Camera Access" IsEnabled="False" />
            <CheckBox IsChecked="{Binding SpeechTranscriptionAccessGranted, Mode=OneWay}" Foreground="#E2E8F0" Content="Speech-to-Text Access (OpenAI key)" IsEnabled="False" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Recheck" Command="{Binding RecheckCommand}" />
                <Button Content="Continue"
                        Command="{Binding ContinueCommand}"
                        Height="42"
                        Background="#2563EB"
                        Foreground="White"
                        FontWeight="SemiBold" />
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" Foreground="#E2E8F0" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
