{
  "MongoDb": {
    "ConnectionString": "mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority",
    "DatabaseName": "MockUpAI",
    "UsersCollectionName": "users",
    "InterviewsCollectionName": "interviews"
  },
  "OpenAi": {
    "Enabled": false,
    "ApiKey": "<optional-openai-api-key-or-use-admin-vault>",
    "Model": "gpt-4.1-mini",
    "TranscriptionModel": "gpt-4o-mini-transcribe",
    "SpeechModel": "gpt-4o-mini-tts",
    "BaseUrl": "https://api.openai.com/v1"
  },
  "Gemini": {
    "Enabled": false,
    "ApiKey": "<optional-gemini-api-key>",
    "Model": "gemini-1.5-flash",
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta"
  },
  "AzureSpeech": {
    "Enabled": false,
    "ApiKey": "<optional-azure-speech-key>",
    "Region": "<optional-azure-region>",
    "Language": "en-US"
  },
  "WhisperLocal": {
    "Enabled": true,
    "Model": "base.en",
    "ModelPath": "",
    "AutoDownload": true,
    "AccurateRetryEnabled": true,
    "TimeoutSeconds": 75,
    "MaxThreads": 8,
    "SilencePaddingMs": 220,
    "MinimumSpeechMs": 350
  },
  "ElevenLabs": {
    "Enabled": false,
    "ApiKey": "<optional-elevenlabs-api-key>"
  },
  "SeedAdmin": {
    "UserId": "admin",
    "Password": "<set-a-strong-local-password>"
  }
}
